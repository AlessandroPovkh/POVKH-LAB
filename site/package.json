{
  "name": "povkh-lab-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free static site for POVKH LAB",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "audio:stream": "node tools/generate-streaming-audio.mjs",
    "visuals": "node tools/generate-release-visuals.mjs",
    "og": "node tools/generate-og.mjs",
    "waveforms": "node tools/generate-waveforms.mjs",
    "serve": "node tools/serve.mjs",
    "check": "node tools/check.mjs",
    "check:pages-base": "node tools/check-pages-base.mjs",
    "qa": "node tools/qa.mjs",
    "assets:merch": "node tools/export-merch-assets.mjs",
    "assets:apparel-registration": "node tools/render-apparel-registration.mjs",
    "test:merch": "node --test tools/merch.test.mjs",
    "test:merch-assets": "node --test tools/merch-assets.test.mjs",
    "test:merch-assets:source": "PVKH_VERIFY_PRIVATE_MERCH_SOURCES=1 node --test tools/merch-assets.test.mjs",
    "test:merch-pages": "node --test tools/merch-pages.test.mjs",
    "test:social-links": "node --test tools/social-links.test.mjs",
    "test:merch-registration": "node --test tests/merch-registration.test.mjs",
    "test:merch-viewer-contract": "node --test tests/merch-viewer-contract.test.mjs",
    "test:interface-hierarchy": "node --test tests/interface-hierarchy.test.mjs",
    "test": "npm run test:merch && npm run test:merch-assets && npm run test:merch-pages && npm run test:social-links && npm run test:merch-registration && npm run test:merch-viewer-contract && npm run test:interface-hierarchy && npm run build && npm run check && npm run qa"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@zxing/library": "0.21.3",
    "playwright": "1.61.1"
  }
}
